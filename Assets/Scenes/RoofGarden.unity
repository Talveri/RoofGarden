      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7836690308615333156, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0]'
      value: Hey, Mr. Player!
      objectReference: {fileID: 0}
    - target: {fileID: 7836690308615333156, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1]'
      value: I'm Jenny!
      objectReference: {fileID: 0}
    - target: {fileID: 7836690308615333156, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2]'
      value: I heard you are working on the garden on the rooftop!
      objectReference: {fileID: 0}
    - target: {fileID: 7836690308615333156, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3]'
      value: Could you lend me some of the vegetables you grow?
      objectReference: {fileID: 0}
    - target: {fileID: 7836690308615333156, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4]'
      value: That would be very nice!
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: dialogue
      value: 
      objectReference: {fileID: 280873892}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[0].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[1].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[2].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[3].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[4].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[0]'
      value: Mr. Player, hi!!
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[1]'
      value: Your garden makes this building feel so alive.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[2]'
      value: "It\u2019s such a wonderful thing you\u2019ve created for everyone."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[0]'
      value: Hey, Mr. Player!
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[1]'
      value: Your garden brings such a warm feeling to this place.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[2]'
      value: It really brightens my day.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[0]'
      value: Hi, Mr. Player!
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[1]'
      value: Your rooftop garden is really lovely.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[2]'
      value: "It\u2019s nice knowing something like that exists here."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[0]'
      value: Hey, Mr. Player.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[1]'
      value: Your garden looks really beautiful.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[2]'
      value: "I can\u2019t help but feel a little left out sometimes."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[0]'
      value: "Hi, Mr. Player\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[1]'
      value: I see your garden up there every day.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[2]'
      value: I just wish it felt more welcoming to everyone.
      objectReference: {fileID: 0}
