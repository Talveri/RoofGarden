    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[1].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[2].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[3].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: script.Array.data[4].lines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[0]'
      value: "Hey, Mr. Player\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[1]'
      value: "I respect what you\u2019ve built up there."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[0].lines.Array.data[2]'
      value: It shows that things can get better with effort.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[0]'
      value: Hey, Mr. Player.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[1]'
      value: That garden of yours is a good thing.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[1].lines.Array.data[2]'
      value: It gives this place a bit of hope.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[0]'
      value: Hey, Mr. Player.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[1]'
      value: "What you\u2019re doing up there makes sense."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[2].lines.Array.data[2]'
      value: Growing your own food is a smart move these days.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[0]'
      value: Hi, Mr. Player.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[1]'
      value: "Your garden\u2019s doing well, from what I can tell."
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[3].lines.Array.data[2]'
      value: I just wish things felt a bit more balanced around here.
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[0]'
      value: "Hey, Mr. Player\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[1]'
      value: "Seeing that garden every day\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8094144441260522448, guid: 96ce7abe85f62e1a096183a034d5e930, type: 3}
      propertyPath: 'script.Array.data[4].lines.Array.data[2]'
      value: "It\u2019s hard not to think about what some of us are missing."
      objectReference: {fileID: 0}
